// Read on every start from TIQR_HOME (beside the executable when unset). `tiqr install` copies it there.
// Restart to apply changes.
// Precedence: .env < .env.local < this file < environment. Null keeps the lower layer.
// Never put TIQR_SECRET_KEY here; it belongs in .env.local.
{
  // Branding (required)
  "app_name": "TiQR", // default: TiQR
  "logo_path": null, // default: none
  // "default" is vintage; or any Skeleton theme name (e.g. "cerberus", "dracula").
  "theme": "default", // default: default (vintage) https://skeleton.dev/docs/svelte/design/themes
  // The browser's language is used when offered; otherwise the first language is the default.
  "languages": ["en-US", "ru-RU", "az-AZ"], // default: en-US, ru-RU, az-AZ

  // Tickets
  "prefix": "TQR", // default: TQR
  "default_tz": null, // default: this machine's time zone, else UTC

  // Web server (`tiqr serve`)
  "host": null, // default: 127.0.0.1
  "port": null, // default: 7102
  "tls_cert": null, // default: none (plain HTTP)
  "tls_key": null, // default: none (plain HTTP)
  "server_printing": null, // default: false

  // BioStar (leave all null for local mode; a partly filled block is an error)
  "biostar": {
    "base_url": null, // default: none; required with the block
    "username": null, // default: none; required with the block
    "password": null, // default: none; required with the block
    "device_ids": null, // default: none; required with the block
    "access_group_id": null, // default: blank, TiQR manages its own group
    "verify_tls": null, // default: false
    "timeout": null, // default: 30 seconds
    "door_open_duration": null, // default: 3 seconds
    "door_open_timeout": null // default: 10 seconds
  }
}
