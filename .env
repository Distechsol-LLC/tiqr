# Committed, non-secret settings. Private values go in .env.local (not committed).
# Ticket prefix for readable serials in QR: any three characters (no : or -).
TIQR_PREFIX=TQR
# Output timezone (IANA name). Blank uses this machine's zone, or UTC when that can't be read.
TIQR_DEFAULT_TZ=
# ticket (default) or badge; each keeps its own database. The web app's Settings page sets it.
TIQR_MODE=

# BioStar connection. Blank means unset (local mode). CI fills these in or sets real
# environment variables; .env.local overrides them locally. Keep the password out of git.
TIQR_BIOSTAR_BASE_URL=
TIQR_BIOSTAR_USERNAME=
TIQR_BIOSTAR_PASSWORD=
# Comma-separated reader IDs; every one is added to the TiQR access group.
TIQR_BIOSTAR_DEVICE_IDS=
# Optional. Blank lets `tiqr setup` create and manage an access group named TiQR.
TIQR_BIOSTAR_ACCESS_GROUP_ID=
# true verifies BioStar's TLS certificate; blank means false.
TIQR_BIOSTAR_VERIFY_TLS=
# Seconds a door stays unlocked after a granted scan, and how long it may stay open (default 3 and 10).
TIQR_BIOSTAR_DOOR_OPEN_DURATION=
TIQR_BIOSTAR_DOOR_OPEN_TIMEOUT=

# Web server (`tiqr serve`). Blank means the default. Relative TLS paths follow the project root.
# Bind address and port; the default 127.0.0.1:7102 is reachable from this machine only, so
# set TIQR_HOST to the server's LAN address for operators' PCs.
TIQR_HOST=
TIQR_PORT=
# Optional PEM certificate and private key. Blank serves plain HTTP on the local network;
# set both to serve HTTPS instead.
TIQR_TLS_CERT=
TIQR_TLS_KEY=
# true lets operators print on this server's default printer as well as download the PDF.
TIQR_SERVER_PRINTING=
