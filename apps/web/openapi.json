  "components": {
    "schemas": {
      "AssignIn": {
        "properties": {
          "assignee": {
            "type": "string",
            "maxLength": 150,
            "title": "Assignee",
            "description": "Username of any existing account"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "assignee"
        ],
        "title": "AssignIn"
      },
      "ConfigOut": {
        "properties": {
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "description": "TIQR_DEFAULT_TZ, for input and display"
          },
          "server_printing": {
            "type": "boolean",
            "title": "Server Printing",
            "description": "Whether /print reaches a printer"
          }
        },
        "type": "object",
        "required": [
          "timezone",
          "server_printing"
        ],
        "title": "ConfigOut"
      },
      "CountOut": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "count"
        ],
        "title": "CountOut"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "forbidden",
              "csrf",
              "cross_origin",
              "not_found",
              "conflict",
              "server_printing_off",
              "invalid",
              "rate_limited",
              "printer",
              "biostar",
              "internal"
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorOut",
        "description": "A refusal: a message to show, and a stable code to branch on."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ctx"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "FieldErrorsOut": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "FieldErrorsOut",
        "description": "A malformed request, as FastAPI reports it: one entry per bad field."
      },
      "HealthOut": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthOut"
      },
      "LoginIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 150,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginIn"
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "manager",
          "operator"
        ],
        "title": "Role"
      },
      "SessionOut": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token",
            "description": "Send as X-CSRF-Token on every write request"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "When the session ends, however active"
          },
          "idle_timeout": {
            "type": "integer",
            "title": "Idle Timeout",
            "description": "Seconds without a request that end it"
          }
        },
        "type": "object",
        "required": [
          "user",
          "csrf_token",
          "expires_at",
          "idle_timeout"
        ],
        "title": "SessionOut"
      },
      "StatsOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "issued": {
            "type": "integer",
            "title": "Issued"
          },
          "passed": {
            "type": "integer",
            "title": "Passed"
          },
          "expired": {
            "type": "integer",
            "title": "Expired"
          },
          "uses": {
            "type": "integer",
            "title": "Uses"
          },
          "prints": {
            "type": "integer",
            "title": "Prints"
          }
        },
        "type": "object",
        "required": [
          "total",
          "issued",
          "passed",
          "expired",
          "uses",
          "prints"
        ],
        "title": "StatsOut"
      },
      "TicketIn": {
        "properties": {
          "visitor_name": {
            "type": "string",
            "maxLength": 200,
            "title": "Visitor Name"
          },
          "visitor_type": {
            "type": "string",
            "maxLength": 200,
            "title": "Visitor Type"
          },
          "valid_from": {
            "type": "string",
            "maxLength": 64,
            "title": "Valid From",
            "description": "ISO datetime with a time; without an offset it is read in `timezone`",
            "examples": [
              "2030-06-01T09:00",
              "2030-06-01T09:00:00+04:00"
            ]
          },
          "valid_until": {
            "type": "string",
            "maxLength": 64,
            "title": "Valid Until",
            "description": "ISO datetime with a time; without an offset it is read in `timezone`",
            "examples": [
              "2030-06-01T09:00",
              "2030-06-01T09:00:00+04:00"
            ]
          },
          "usage_type": {
            "$ref": "#/components/schemas/UsageType"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone",
            "description": "IANA zone for offset-less times; default the server's TIQR_DEFAULT_TZ"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "visitor_name",
          "visitor_type",
          "valid_from",
          "valid_until",
          "usage_type"
        ],
        "title": "TicketIn"
      },
      "TicketOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "readable_serial": {
            "type": "string",
            "title": "Readable Serial"
          },
          "visitor_name": {
            "type": "string",
            "title": "Visitor Name"
          },
          "visitor_type": {
            "type": "string",
            "title": "Visitor Type"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "title": "Valid From"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "title": "Valid Until"
          },
          "usage_type": {
            "$ref": "#/components/schemas/UsageType"
          },
          "state": {
            "$ref": "#/components/schemas/TicketState"
          },
          "created_by": {
            "type": "string",
            "format": "uuid",
            "title": "Created By"
          },
          "assigned_operator": {
            "type": "string",
            "format": "uuid",
            "title": "Assigned Operator"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "passed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed At"
          },
          "print_count": {
            "type": "integer",
            "title": "Print Count"
          },
          "use_count": {
            "type": "integer",
            "title": "Use Count"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "description": "The zone every datetime here is shown in"
          }
        },
        "type": "object",
        "required": [
          "id",
          "readable_serial",
          "visitor_name",
          "visitor_type",
          "valid_from",
          "valid_until",
          "usage_type",
          "state",
          "created_by",
          "assigned_operator",
          "created_at",
          "passed_at",
          "print_count",
          "use_count",
          "timezone"
        ],
        "title": "TicketOut"
      },
      "TicketState": {
        "type": "string",
        "enum": [
          "issued",
          "passed",
          "expired"
        ],
        "title": "TicketState"
      },
      "UsageType": {
        "type": "string",
        "enum": [
          "one_time",
          "multi_use"
        ],
        "title": "UsageType"
      },
      "UserIn": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 150,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "title": "Password"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "role"
        ],
        "title": "UserIn"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "active"
        ],
        "title": "UserOut"
      },
      "UserPatch": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active",
            "description": "false deactivates; true reactivates"
          },
          "password": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "title": "Password",
            "description": "Resets the password; ends the user's sessions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "UserPatch",
        "description": "Any of: a new role, an active state, a new password. Omitted fields stay as they are."
      }
    }
  }
}
