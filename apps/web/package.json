{
  "name": "tiqr-web",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "keywords": [
    "qr-ticketing",
    "biostar"
  ],
  "description": "QR Ticketing System for Suprema BioStar X",
  "repository": "github:Distechsol-LLC/tiqr",
  "scripts": {
    "dev": "vite --open",
    "bundle": "tsc -b && vite build",
    "serve": "bun bundle && vite preview",
    "check": "bun test --randomize --pass-with-no-tests",
    "check:w": "bun check --watch",
    "cover": "bun check --coverage",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "fix:s": "bun fix && svelte-check --incremental --tsgo",
    "orphans": "knip-bun --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "ignoreFiles": [
      "tailwind.config.css"
    ],
    "ignoreDependencies": [
      "@commitlint/cli",
      "@skeletonlabs/skeleton",
      "@typescript/native-preview",
      "tailwindcss"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "sv-router": "^0.19.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tippy.js": "^6.3.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
