{
  "name": "tiqr-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "qr-ticketing",
    "biostar"
  ],
  "description": "QR Ticketing System for Suprema BioStar X",
  "repository": "github:Distechsol-LLC/tiqr",
  "scripts": {
    "dev": "vite --open",
    "bundle": "tsc -b && vite build",
    "serve": "bun bundle && vite preview",
    "check": "bun test __tests__/**/*.{test,spec}.{ts,tsx} --randomize --pass-with-no-tests",
    "check:w": "bun check --watch",
    "cover": "bun check --coverage",
    "fix": "biome check --fix --unsafe --no-errors-on-unmatched --reporter=concise",
    "fix:s": "bun fix && svelte-check --incremental --tsgo",
    "orphans": "knip-bun --cache --no-exit-code"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "ignoreFiles": [
      "tailwind.config.css"
    ],
    "ignoreDependencies": [
      "@typescript/native-preview",
      "tailwindcss"
    ]
  },
  "dependencies": {
    "@fontsource-variable/handjet": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "pixelarticons": "^2.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tippy.js": "^6.3.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
