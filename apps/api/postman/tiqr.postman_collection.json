            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cleaned up', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Removes finished tickets from BioStar now. **200** with `count`; **502** if BioStar fails.",
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/cleanup"
          }
        },
        {
          "name": "Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stats read', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Totals: `total`, `issued`, `passed`, `expired`, plus `visitor_types` and `ticket_types`. **200**.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stats"
          }
        },
        {
          "name": "Stats for a date range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dated stats read', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "The same figures, only for tickets created on these days in `TIQR_DEFAULT_TZ`; both ends are inclusive and either may be left out. **200**; **422** if the end is before the start.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/stats?since=2026-09-01&until=2026-09-30"
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "description": "These should fail. Run last: the wrong password counts toward the login limit.",
      "item": [
        {
          "name": "Wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wrong password refused', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "description": "**401**; **429** after 5 failures.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Write without CSRF token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF refused', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "description": "No `X-CSRF-Token` header. **403**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visitor_name\": \"No Token\",\n  \"visitor_type\": \"Contractor\",\n  \"valid_from\": \"2030-06-01T09:00\",\n  \"valid_until\": \"2030-06-01T17:00\",\n  \"usage_type\": \"one_time\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Write from another origin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cross-origin refused', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "description": "Foreign `Origin` header. **403**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Origin",
                "value": "https://evil.example"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"intruder\",\n  \"password\": \"change-me-please\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
