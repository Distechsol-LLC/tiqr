  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('No server error (5xx)', () => pm.expect(pm.response.code).to.be.below(500));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:7102",
      "description": "Server address. Use https:// if TLS is on."
    },
    {
      "key": "username",
      "value": "admin",
      "description": "Your account."
    },
    {
      "key": "password",
      "value": "",
      "description": "Your password. Keep it blank in shared copies."
    },
    {
      "key": "csrfToken",
      "value": "",
      "description": "Set by Login."
    },
    {
      "key": "newUserId",
      "value": "",
      "description": "Set by Create user."
    },
    {
      "key": "ticketId",
      "value": "",
      "description": "Set by Issue ticket."
