    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signed in', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', body.csrf_token);"
                ]
              }
            }
          ],
          "request": {
            "description": "Sets the session cookie and saves `csrfToken`. **200**; **401** for wrong credentials; **429** when throttled.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session is live', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "The current user. **200**; **401** if the session ended.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/session"
          }
        },
        {
          "name": "License status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('License status read', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Any role, even without a license. **200** with `state`, `is_valid` and `machine_id`.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/license/status"
          }
        },
        {
          "name": "License request code",
          "request": {
            "description": "Any role: a code to send the vendor. **200**.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/license/request-code"
          }
        },
        {
          "name": "License history",
          "request": {
            "description": "Admins only: stored keys, newest first, mostly hidden. **200**; **403** otherwise.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/license/history"
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Listing: admin or manager. Changing users: admin only.",
      "item": [
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Users listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Admins and managers. **200**; **403** for operators. One page: `?page=1&size=10` (size up to 100).",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "[WRITE] Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('newUserId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "description": "Roles: `admin`, `manager`, `operator`; managers create operators only. Saves `newUserId`. Change the username if it exists already. **201**; **422** for a blank or taken username.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"clerk\",\n  \"password\": \"change-me-please\",\n  \"role\": \"operator\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "[WRITE] Change role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Role changed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Admins only. **200**; **403** otherwise.",
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users/{{newUserId}}"
          }
        },
        {
          "name": "[WRITE] Deactivate user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deactivated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Blocks sign-in and ends their sessions. Managers may do this to operators. **200**.",
