{
  "info": {
    "_postman_id": "7c1f4e2a-3b8d-4f6e-9a51-2d0b7e6c9a10",
    "name": "TiQR API",
    "description": "Fill in `username` and `password`, run **Login** first, then the folders top to bottom. **[WRITE]** requests change data: use a test server. Everything but Health, Branding, Login, Session and the license reads needs an active license. Don't export with a password filled in.",
