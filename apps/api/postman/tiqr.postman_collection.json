    {
      "name": "Tickets",
      "description": "Operators see and print only tickets assigned to them.",
      "item": [
        {
          "name": "List tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tickets listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Operators see only tickets assigned to them. **200**. One page, newest first: `?page=1&size=10`. Also `?search=` (serial, visitor or type) and `?external_code=` (exact).",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?page=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "List issued tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Issued tickets listed', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Filter by `state`: `issued`, `passed`, `expired` or `revoked`. **200**.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?state=issued",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "issued"
                }
              ]
            }
          }
        },
        {
          "name": "[WRITE] Issue ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket issued', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('ticketId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "description": "Saves `ticketId`. Times without an offset use `timezone`. Optional: `ticket_type`, `external_code`, `event_session`. Add an `Idempotency-Key` header to make a retry safe. **201**; **422** for bad input (or an unknown `ticket_type`); **409** if `external_code` is taken.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visitor_name\": \"Jane Doe\",\n  \"visitor_type\": \"Contractor\",\n  \"valid_from\": \"2030-06-01T09:00\",\n  \"valid_until\": \"2030-06-01T17:00\",\n  \"usage_type\": \"one_time\",\n  \"timezone\": \"Asia/Dubai\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Get ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket read', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "**200**; **403** for an operator if it isn't assigned to them.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
          }
        },
        {
          "name": "[WRITE] Assign ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ticket assigned', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Managers only (**403** for others). `assignee` is an existing, active username: run **Create user** and keep it active. **200**; **404** if it doesn't exist; **409** if it is deactivated.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee\": \"clerk\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/assign"
          }
        },
        {
          "name": "[WRITE] Render badge PDF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Badge rendered as PDF', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "description": "Returns a PDF and counts as a print. Issued tickets only. **200**; **409** otherwise.",
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/pdf"
          }
        },
        {
          "name": "[WRITE] Print on server printer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Printed, or printing is off', () => pm.expect([200, 409, 502]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "description": "Needs `TIQR_SERVER_PRINTING=true`. **200**; **409** when it's off; **502** if the printer fails.",
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/print"
          }
        },
        {
          "name": "[WRITE] Change validity window",
          "request": {
            "description": "Admins and managers; either end may be left out. Issued, or passed and multi-use, tickets only. **200**; **409** otherwise; **422** if the end is not after the start; **502** if BioStar fails.",
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valid_until\": \"2030-06-01T18:00\",\n  \"timezone\": \"Asia/Dubai\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[WRITE] Transfer ticket",
          "request": {
            "description": "Moves it to another `event_session`, keeping id, state and history. **200**; **409**; **502**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_session\": \"Matinee\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[WRITE] Reissue ticket",
          "request": {
            "description": "Back to issued, as the same ticket; the window may move and must end in the future. Add an `Idempotency-Key` header to make a retry safe. **200**; **409**; **502**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/reissue",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"valid_from\": \"2030-06-02T09:00\",\n  \"valid_until\": \"2030-06-02T17:00\",\n  \"timezone\": \"Asia/Dubai\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ticket audit",
          "request": {
            "description": "Admins and managers: every change, oldest first. **200**.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/audit"
          }
        },
        {
          "name": "[WRITE] Batch issue",
          "request": {
            "description": "Up to `TIQR_BATCH_MAX_SIZE` tickets. **200** with a result per item, unless the request is malformed. With `atomic` true, one failure undoes the rest (`rolled_back`, `skipped`).",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/batch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"atomic\": false,\n  \"items\": [\n    {\n      \"visitor_name\": \"Ada\",\n      \"visitor_type\": \"Guest\",\n      \"valid_from\": \"2030-06-01T09:00\",\n      \"valid_until\": \"2030-06-01T17:00\",\n      \"usage_type\": \"one_time\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[WRITE] Revoke ticket",
          "request": {
            "description": "Admins and managers. Cancels it and removes access in BioStar; revoking twice returns it unchanged. Run after the other ticket requests. **200**; **409** if expired; **502** if BioStar fails.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/revoke",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Lost card\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Service keys",
      "description": "Admins only, signed in with a session.",
      "item": [
        {
          "name": "[WRITE] Create service key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service key created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('serviceKeyId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "description": "The `secret` is shown once. Saves `serviceKeyId`. **201**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/service-keys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"box-office\",\n  \"scopes\": [\n    \"tickets:read\",\n    \"tickets:write\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List service keys",
          "request": {
            "description": "No secrets. **200**.",
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/service-keys"
          }
        },
        {
          "name": "[WRITE] Rotate service key",
          "request": {
            "description": "Issues a successor; the old key works on for `grace_minutes` (0 to 10080). **201**.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/service-keys/{{serviceKeyId}}/rotate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grace_minutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "[WRITE] Revoke service key",
          "request": {
            "description": "Ends the key at once. **200**; **404** if gone.",
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/service-keys/{{serviceKeyId}}"
          }
        }
      ]
    },
    {
      "name": "Operations",
      "description": "Admins and managers.",
      "item": [
        {
          "name": "[WRITE] Sync access events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Synced', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "description": "Runs a BioStar sync now. **200** with `count`; **502** if BioStar fails.",
