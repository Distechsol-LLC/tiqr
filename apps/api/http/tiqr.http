# TiQR API. Start the server (`uv run tiqr serve`), set the username in
# http-client.env.json and the password in http-client.private.env.json, then run
# Login first and the rest top to bottom. [WRITE] requests change data: use a test server.
# Everything but Health, Branding, Login, Session and the license reads needs an active license.
# Login is rate-limited: 5 failed sign-ins per user and address in 15 minutes.


### Health
# No sign-in or license needed. 200 when ready; 503 if the database or scheduler is down.
GET {{baseUrl}}/api/health

> {%
  client.test("Healthy", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### Branding
# No sign-in or license needed. App name, theme, languages, currencies and has_logo. 200.
GET {{baseUrl}}/api/branding

> {%
  client.test("Branding read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### Config
# Needs sign-in: run Login first. Default timezone and whether server printing is on. 200; 401.
GET {{baseUrl}}/api/config

> {%
  client.test("Config read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}


### Login
# Sets the session cookie and saves csrfToken. 200; 401 for wrong credentials; 429 when throttled.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
  client.test("Signed in", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
  client.global.set("csrfToken", response.body.csrf_token);
%}

### Session
# The current user. 200; 401 if the session ended.
GET {{baseUrl}}/api/auth/session

> {%
  client.test("Session is live", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### License status
# Any role, even without a license. 200 with state, is_valid and machine_id.
GET {{baseUrl}}/api/license/status

> {%
  client.test("License status read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### License request code
# Any role: a code to send the vendor. 200.
GET {{baseUrl}}/api/license/request-code

### License history
# Admins only: stored keys, newest first, mostly hidden. 200; 403 otherwise.
GET {{baseUrl}}/api/license/history


### List users
# Admins and managers. 200; 403 for operators. One page: ?page=1&size=10 (size up to 100).
GET {{baseUrl}}/api/users?page=1&size=10
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Users listed", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### [WRITE] Create user
# Roles: admin, manager, operator; managers create operators only. Saves newUserId.
# Change the username if it exists already. 201; 422 for a blank or taken username.
POST {{baseUrl}}/api/users
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "username": "clerk",
  "password": "change-me-please",
  "role": "operator"
}

> {%
  client.test("User created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.global.set("newUserId", response.body.id);
%}

### [WRITE] Change role
# Admins only. 200; 403 otherwise.
PATCH {{baseUrl}}/api/users/{{newUserId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "role": "manager"
}

### [WRITE] Deactivate user
# Blocks sign-in and ends their sessions. Managers may do this to operators. 200.
PATCH {{baseUrl}}/api/users/{{newUserId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "active": false
}

### [WRITE] Reactivate user
# 200.
PATCH {{baseUrl}}/api/users/{{newUserId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "active": true
}

### [WRITE] Reset password
# Ends their sessions. 200.
PATCH {{baseUrl}}/api/users/{{newUserId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "password": "another-password"
}

### [WRITE] Delete user
# Admins only. Run Deactivate user first, or this is refused since Reactivate ran above; then
# Assign ticket below finds no "clerk". 204; 409 if active or they created or hold tickets.
DELETE {{baseUrl}}/api/users/{{newUserId}}
X-CSRF-Token: {{csrfToken}}


### List ticket types
# Every role may read. 200. One page, by name: ?page=1&size=10.
GET {{baseUrl}}/api/ticket-types?page=1&size=10

### [WRITE] Create ticket type
# Admins and managers. price_minor is in minor units (1250 is 12.50); currency must be one the
# server offers (see /api/branding). Saves ticketTypeId. 201; 422 for a blank or taken name.
POST {{baseUrl}}/api/ticket-types
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "name": "Day pass",
  "price_minor": 1250,
  "currency": "USD"
}

> {%
  client.test("Ticket type created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.global.set("ticketTypeId", response.body.id);
%}

### [WRITE] Change ticket type
# Any of name, price_minor, currency. 200; 404 if gone.
PATCH {{baseUrl}}/api/ticket-types/{{ticketTypeId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "price_minor": 1500
}

### List visitor types
# Every role may read. 200. One page, by name: ?page=1&size=10.
GET {{baseUrl}}/api/visitor-types?page=1&size=10

### [WRITE] Create visitor type
# Admins and managers. discount_percent is 0 to 100. Saves visitorTypeId. 201.
POST {{baseUrl}}/api/visitor-types
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "name": "Student",
  "discount_percent": 20
}

> {%
  client.test("Visitor type created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.global.set("visitorTypeId", response.body.id);
%}

### [WRITE] Change visitor type
# Any of name, discount_percent. 200; 404 if gone.
PATCH {{baseUrl}}/api/visitor-types/{{visitorTypeId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "discount_percent": 25
}

### [WRITE] Delete visitor type
# Issued tickets keep their discount. 204; 404 if gone.
DELETE {{baseUrl}}/api/visitor-types/{{visitorTypeId}}
X-CSRF-Token: {{csrfToken}}

### [WRITE] Delete ticket type
# Issued tickets keep their price. 204; 404 if gone.
DELETE {{baseUrl}}/api/ticket-types/{{ticketTypeId}}
X-CSRF-Token: {{csrfToken}}


### List tickets
# Operators see only tickets assigned to them. 200. One page, newest first: ?page=1&size=10.
# Also ?search= (serial, visitor or type) and ?external_code= (exact).
GET {{baseUrl}}/api/tickets?page=1&size=10
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Tickets listed", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### List issued tickets
# Filter by state: issued, passed, expired or revoked. 200.
GET {{baseUrl}}/api/tickets?state=issued
X-CSRF-Token: {{csrfToken}}

### [WRITE] Issue ticket
# Saves ticketId. Times without an offset use "timezone". Optional: ticket_type, external_code,
# event_session. Add an Idempotency-Key header to make a retry safe.
# 201; 422 for bad input (or an unknown ticket_type); 409 if external_code is taken.
POST {{baseUrl}}/api/tickets
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "visitor_name": "Jane Doe",
  "visitor_type": "Contractor",
  "valid_from": "2030-06-01T09:00",
  "valid_until": "2030-06-01T17:00",
  "usage_type": "one_time",
  "timezone": "Asia/Dubai"
}

> {%
  client.test("Ticket issued", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.global.set("ticketId", response.body.id);
%}

### Get ticket
# 200; 403 for an operator if it isn't assigned to them.
GET {{baseUrl}}/api/tickets/{{ticketId}}
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Ticket read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### [WRITE] Assign ticket
# Managers only (403 for others). assignee is an existing, active username: run Create user
# and keep it active. 200; 404 if it doesn't exist; 409 if it is deactivated.
POST {{baseUrl}}/api/tickets/{{ticketId}}/assign
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "assignee": "clerk"
}

### [WRITE] Render badge PDF
# Returns a PDF and counts as a print. Issued tickets only. 200; 409 otherwise.
POST {{baseUrl}}/api/tickets/{{ticketId}}/pdf
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Badge rendered", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.contentType.mimeType === "application/pdf", "Expected a PDF");
  });
%}

### [WRITE] Print on server printer
# Needs TIQR_SERVER_PRINTING=true. 200; 409 when off; 502 if the printer fails.
POST {{baseUrl}}/api/tickets/{{ticketId}}/print
X-CSRF-Token: {{csrfToken}}

### [WRITE] Change validity window
# Admins and managers; either end may be left out. Issued, or passed and multi-use, tickets only.
# 200; 409 otherwise; 422 if the end is not after the start; 502 if BioStar fails.
PATCH {{baseUrl}}/api/tickets/{{ticketId}}
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "valid_until": "2030-06-01T18:00",
  "timezone": "Asia/Dubai"
}

### [WRITE] Transfer ticket
# Moves it to another event_session, keeping id, state and history. 200; 409; 502.
POST {{baseUrl}}/api/tickets/{{ticketId}}/transfer
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "event_session": "Matinee"
}

### [WRITE] Reissue ticket
# Back to issued, as the same ticket; the window may move and must end in the future.
# Add an Idempotency-Key header to make a retry safe. 200; 409; 502.
POST {{baseUrl}}/api/tickets/{{ticketId}}/reissue
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "valid_from": "2030-06-02T09:00",
  "valid_until": "2030-06-02T17:00",
  "timezone": "Asia/Dubai"
}

### Ticket audit
# Admins and managers: every change, oldest first. 200.
GET {{baseUrl}}/api/tickets/{{ticketId}}/audit

### [WRITE] Batch issue
# Up to TIQR_BATCH_MAX_SIZE tickets. 200 with a result per item, unless the request is malformed.
# With atomic true, one failure undoes the rest (rolled_back, skipped).
POST {{baseUrl}}/api/tickets/batch
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "atomic": false,
  "items": [
    {
      "visitor_name": "Ada",
      "visitor_type": "Guest",
      "valid_from": "2030-06-01T09:00",
      "valid_until": "2030-06-01T17:00",
      "usage_type": "one_time"
    }
  ]
}

### [WRITE] Revoke ticket
# Admins and managers. Cancels it and removes access in BioStar; revoking twice returns it
# unchanged. Run after the other ticket requests. 200; 409 if expired; 502 if BioStar fails.
POST {{baseUrl}}/api/tickets/{{ticketId}}/revoke
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "reason": "Lost card"
}

### [WRITE] Create service key
# Admins only, signed in. The secret is shown once; saves serviceKeyId. 201.
POST {{baseUrl}}/api/service-keys
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "name": "box-office",
  "scopes": ["tickets:read", "tickets:write"]
}

> {%
  client.test("Service key created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
  });
  client.global.set("serviceKeyId", response.body.id);
%}

### List service keys
# Admins only; no secrets. 200.
GET {{baseUrl}}/api/service-keys

### [WRITE] Rotate service key
# Issues a successor; the old key works on for grace_minutes (0 to 10080). 201.
POST {{baseUrl}}/api/service-keys/{{serviceKeyId}}/rotate
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "grace_minutes": 60
}

### [WRITE] Revoke service key
# Ends the key at once. 200; 404 if gone.
DELETE {{baseUrl}}/api/service-keys/{{serviceKeyId}}
X-CSRF-Token: {{csrfToken}}


### [WRITE] Sync access events
# Runs a BioStar sync now. 200 with count; 502 if BioStar fails.
POST {{baseUrl}}/api/sync
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Synced", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### [WRITE] Clean up finished tickets
# Removes finished tickets from BioStar now. 200 with count; 502 if BioStar fails.
POST {{baseUrl}}/api/cleanup
X-CSRF-Token: {{csrfToken}}

### Stats
# Admins and managers. Totals: total, issued, passed, expired, plus visitor_types and ticket_types.
# 200.
GET {{baseUrl}}/api/stats
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Stats read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}

### Stats for a date range
# The same figures, only for tickets created on these days in TIQR_DEFAULT_TZ; both ends are
# inclusive and either may be left out. 200.
GET {{baseUrl}}/api/stats?since=2026-09-01&until=2026-09-30
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Dated stats read", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
  });
%}


### Wrong password
# Run these last: this one counts toward the login limit. 401. 429 after 5 failures.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "definitely-wrong"
}

> {%
  client.test("Wrong password refused", function() {
    client.assert(response.status === 401, "Expected 401, got " + response.status);
  });
%}

### Write without CSRF token
# No X-CSRF-Token header. 403.
POST {{baseUrl}}/api/tickets
Content-Type: application/json

{
  "visitor_name": "No Token",
  "visitor_type": "Contractor",
  "valid_from": "2030-06-01T09:00",
  "valid_until": "2030-06-01T17:00",
  "usage_type": "one_time"
}

> {%
  client.test("CSRF refused", function() {
    client.assert(response.status === 403, "Expected 403, got " + response.status);
  });
%}

### Write from another origin
# Foreign Origin header. 403.
POST {{baseUrl}}/api/users
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}
Origin: https://evil.example

{
  "username": "intruder",
  "password": "change-me-please",
  "role": "admin"
}

> {%
  client.test("Cross-origin refused", function() {
    client.assert(response.status === 403, "Expected 403, got " + response.status);
  });
%}

### Malformed ticket
# Bad valid_from. 422.
POST {{baseUrl}}/api/tickets
Content-Type: application/json
X-CSRF-Token: {{csrfToken}}

{
  "visitor_name": "Jane Doe",
  "visitor_type": "Contractor",
  "valid_from": "next tuesday",
  "valid_until": "2030-06-01T17:00",
  "usage_type": "one_time"
}

> {%
  client.test("Bad input refused", function() {
    client.assert(response.status === 422, "Expected 422, got " + response.status);
  });
%}

### Unknown ticket
# 404.
GET {{baseUrl}}/api/tickets/00000000-0000-0000-0000-000000000000
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Unknown ticket is 404", function() {
    client.assert(response.status === 404, "Expected 404, got " + response.status);
  });
%}


### Logout
# Run last. 204.
POST {{baseUrl}}/api/auth/logout
X-CSRF-Token: {{csrfToken}}

> {%
  client.test("Signed out", function() {
    client.assert(response.status === 204, "Expected 204, got " + response.status);
  });
%}
