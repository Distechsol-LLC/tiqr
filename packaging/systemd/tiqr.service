# The TiQR server. Enabled at boot, and restarted after any crash or non-zero exit. Expects the
# release layout in DEPLOYMENT.md and the settings in /etc/tiqr/tiqr.env.
[Unit]
Description=TiQR ticket server
After=network-online.target
Wants=network-online.target
# Never give up: a persistent fault keeps retrying, and tiqr-health.timer reports it.
StartLimitIntervalSec=0

[Service]
Type=simple
User=tiqr
Group=tiqr
# Config and data stay in this directory while release folders change under /opt/tiqr.
Environment=TIQR_HOME=/var/lib/tiqr
EnvironmentFile=/etc/tiqr/tiqr.env
ExecStart=/opt/tiqr/current/tiqr serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tiqr
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
