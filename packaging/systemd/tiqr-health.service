# Runs tiqr-health.sh once per timer tick. Expects the release layout in DEPLOYMENT.md, where the
# script ships next to the current release, and the settings in /etc/tiqr/tiqr.env.
[Unit]
Description=TiQR health probe
After=tiqr.service

[Service]
Type=oneshot
User=tiqr
Group=tiqr
EnvironmentFile=-/etc/tiqr/tiqr.env
StateDirectory=tiqr-health
ExecStart=/opt/tiqr/current/tiqr-health.sh
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
